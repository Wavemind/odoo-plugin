<odoo>
    <!-- Portal: sale.order.line restricted to own commercial partner -->
    <record id="rule_portal_sale_order_line_own_partner" model="ir.rule">
        <field name="name">Portal: sale order lines restricted to own commercial partner</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('order_id.partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]
        </field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <!-- Portal: account.move.line restricted to own commercial partner -->
    <record id="rule_portal_account_move_line_own_partner" model="ir.rule">
        <field name="name">Portal: invoice lines restricted to own commercial partner</field>
        <field name="model_id" ref="account.model_account_move_line"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">
            [('move_id.partner_id.commercial_partner_id', '=', user.partner_id.commercial_partner_id.id)]
        </field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
