<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Formulaire de création de tâche côté portail -->
  <template id="portal_task_new_form" name="Portal Task New Form">
    <t t-call="portal.portal_layout">

      <t t-set="breadcrumbs">
        <ol class="breadcrumb">
          <li>
            <a t-att-href="url_for('/my/home')">Mon compte</a>
          </li>
          <li class="active">Créer une tâche</li>
        </ol>
      </t>

      <div class="container mt-3">
        <h2>Créer une nouvelle tâche</h2>

        <t t-if="error">
          <div class="alert alert-danger" t-esc="error"/>
        </t>
        <div class="offer_head">
          <form action="/my/tasks/create" method="post" enctype="multipart/form-data" class="mt-3">
            <!-- CSRF -->
            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

            <!-- Titre -->
            <div class="form-group mb-3">
              <label for="name">Titre</label>
              <input type="text" name="name" id="name" class="form-control" t-att-value="data.get('name','')" required="required"/>
            </div>

            <!-- Type de tâche -->
            <div class="form-group mb-3">
              <label for="task_type">Type de tâche</label>
              <select name="task_type" id="task_type" class="form-control" required="required">
                <option value="">-- Sélectionner --</option>
                <option value="bug" t-att-selected="data.get('task_type','') == 'bug'">Bug</option>
                <option value="feature" t-att-selected="data.get('task_type','') == 'feature'">Nouvelle feature</option>
                <option value="question" t-att-selected="data.get('task_type','') == 'question'">Question</option>
              </select>
            </div>

            <!-- Project -->
            <div class="form-group mb-3">
              <label for="project_id">Projet</label>
              <select name="project_id" id="project_id" class="form-control" required="required">
                <option value="">-- Sélectionner --</option>
                <t t-foreach="projects" t-as="p">
                  <option t-att-value="p.id" t-att-selected="str(p.id) == data.get('project_id','') and 'selected' or None">
                    <t t-esc="p.display_name"/>
                  </option>
                </t>
              </select>
            </div>

            <!-- Description  -->
            <div class="form-group mb-3">
              <label for="description_editor">Description</label>
              <input type="hidden" name="description" id="description_input" t-att-value="data.get('description','')"/>
              <textarea t-attf-class="o_wysiwyg_loader tot_description tot_form_field form-control" id="description" placeholder="Explain your Service Details" rows="4" name="description"/>
            </div>



            <!-- Attachements -->
            <div class="form-group mb-3">
              <label for="attachments">Pièces jointes</label>
              <input type="file" name="attachments" id="attachments" multiple="multiple" class="form-control"/>
            </div>

            <button type="submit" class="btn btn-primary">Créer</button>
            <a t-att-href="url_for('/my/home')" class="btn btn-secondary">Annuler</a>
          </form>
        </div>
      </div>
    </t>
  </template>
</odoo>
