<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire pour les tâches dans l'admin -->
    <record id="view_task_form_portal_custom" model="ir.ui.view">
        <field name="name">project.task.form.portal.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <!-- Supprimer l'affichage de priorité en haut -->
            <xpath expr="//field[@name='priority']" position="replace">
                <!-- Supprimé pour éviter la duplication -->
            </xpath>
            
            <!-- Ajouter task_type et priority sous les étiquettes -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="task_type"/>
                <field name="priority" widget="priority"/>
            </xpath>
        </field>
    </record>

    <!-- Vue liste pour les tâches dans l'admin -->
    <record id="view_task_tree_portal_custom" model="ir.ui.view">
        <field name="name">project.task.tree.portal.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <!-- Ajouter le champ priorité après le champ name -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="priority" widget="priority"/>
            </xpath>
            
            <!-- Ajouter le champ task_type après le champ priority -->
            <xpath expr="//field[@name='priority']" position="after">
                <field name="task_type"/>
            </xpath>
        </field>
    </record>

    <!-- Vue kanban pour les tâches dans l'admin -->
    <record id="view_task_kanban_portal_custom" model="ir.ui.view">
        <field name="name">project.task.kanban.portal.custom</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_kanban"/>
        <field name="arch" type="xml">
            <!-- Ajouter le champ task_type dans le kanban -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="task_type"/>
            </xpath>    
        </field>
    </record>

    <!-- Vue formulaire des stages — flag de validation portail (Story 1.2) -->
    <record id="view_task_type_form_validation_flag" model="ir.ui.view">
        <field name="name">project.task.type.form.validation.flag</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="after">
                <field name="is_awaiting_validation"/>
            </xpath>
        </field>
    </record>
</odoo>
