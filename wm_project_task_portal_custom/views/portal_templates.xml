<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_after_projects_card" inherit_id="project.portal_my_home" priority="40">
        <xpath expr="//div[@id='portal_service_category']/t[1]" position="after">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/project/static/src/img/tasks.svg'"/>
                <t t-set="title">Créer une nouvelle tâche</t>
                <t t-set="url" t-value="'/my/tasks/new'"/>
                <t t-set="text">Soumettre une nouvelle demande o ticket</t>
                <t t-set="placeholder_count" t-value="'custom_task_creation_count'"/>
            </t>
        </xpath>
    </template>
</odoo>
