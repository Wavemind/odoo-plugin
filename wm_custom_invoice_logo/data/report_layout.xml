<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Enregistre « Wavemind » comme mise en page sélectionnable dans
             Paramètres > Sociétés > Mise en page du document.
             noupdate="1" : jamais réécrit par une mise à jour d'Odoo. -->
        <record id="report_layout_wavemind" model="report.layout">
            <field name="name">Wavemind</field>
            <field name="sequence">1</field>
            <field name="view_id" ref="wm_custom_invoice_logo.external_layout_wavemind"/>
        </record>
    </data>

    <!-- Les marges des formats papier DIN 5008 étaient surchargées ici, à
         l'époque où ce layout était un fork du gabarit allemand. Il est
         désormais calqué sur le format papier « A4 » standard d'Odoo, donc
         plus rien ne justifie de patcher un enregistrement du cœur d'Odoo à
         chaque mise à jour du module. Surcharge retirée en 17.0.2.0.0. -->
</odoo>
