<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Enregistre "Wavemind" comme mise en page selectionnable.
             noupdate="1" : jamais ecrase par les mises a jour d'Odoo. -->
        <record id="report_layout_wavemind" model="report.layout">
            <field name="name">Wavemind</field>
            <field name="sequence">1</field>
            <field name="view_id" ref="wm_custom_invoice_logo.external_layout_wavemind"/>
        </record>
    </data>

    <data>
        <!-- Marges DIN 5008 rééquilibrées gauche/droite :
             gauche 13mm + 5mm de retrait adresse = 18mm visuels a gauche,
             17mm a droite. Pas de noupdate : reapplique a chaque mise a jour
             du module pour survivre aux reinitialisations de l10n_din5008. -->
        <record id="l10n_din5008.paperformat_euro_din_a" model="report.paperformat">
            <field name="margin_left">13</field>
            <field name="margin_right">17</field>
        </record>
        <record id="l10n_din5008.paperformat_euro_din" model="report.paperformat">
            <field name="margin_left">13</field>
            <field name="margin_right">17</field>
        </record>
    </data>
</odoo>
