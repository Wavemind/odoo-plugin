<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Layout de facturation Wavemind.

             Contrairement a la version 17, ce template n'est PAS une copie du
             layout DIN 5008 : c'est un heritage primaire. Il herite donc
             automatiquement de toutes les evolutions d'Odoo (bloc adresse,
             metadonnees du document, pagination) et ne redefinit que les deux
             zones reellement specifiques a Wavemind : l'en-tete et le pied.

             C'est ce qui rend le module reellement "robuste aux mises a jour" :
             la copie integrale de la v17 affichait des factures sans numero ni
             date en v19, les champs l10n_din5008_* ayant disparu.

             Pour changer le logo : remplacer static/src/img/company_logo.png -->
        <template id="external_layout_wavemind" name="Wavemind"
                  inherit_id="l10n_din5008.external_layout_din5008" primary="True">

            <!-- En-tete : logo statique, aligne a gauche -->
            <xpath expr="//table[hasclass('company_header')]" position="replace">
                <div style="height: 45mm; width: 100%; display: table;">
                    <div style="display: table-cell; vertical-align: middle; text-align: left; padding-top: 5mm; padding-left: 5mm;">
                        <img src="/wm_custom_invoice_logo/static/src/img/company_logo.png"
                             style="max-height: 18mm; max-width: 80mm;"
                             alt="Wavemind"/>
                    </div>
                </div>
            </xpath>

            <!-- Pied de page : coordonnees Wavemind sur trois colonnes.
                 L'IBAN reste dynamique (compte bancaire porte par le document). -->
            <xpath expr="//div[hasclass('company_details')]" position="replace">
                <div class="company_details">
                    <div style="display: table; width: 100%; border-top: 1px solid #0C0C0C; font-size: 8pt; padding-top: 4px; padding-bottom: 4px;">
                        <div style="display: table-row;">
                            <div style="display: table-cell; width: 33%; vertical-align: top; padding: 4px 0; line-height: 1.1;">
                                Wavemind Sàrl<br/>
                                Rue de Bourg 31<br/>
                                1003 Lausanne<br/>
                                Switzerland
                            </div>
                            <div style="display: table-cell; width: 33%; vertical-align: top; padding: 4px 0; line-height: 1.1;">
                                +41 24 520 00 77<br/>
                                info@wavemind.ch
                            </div>
                            <div style="display: table-cell; width: 34%; vertical-align: top; padding: 4px 0; line-height: 1.1;">
                                <t t-if="company.vat">
                                    <t t-set="default_vat_label">Tax ID</t>
                                    <t t-out="company.account_fiscal_country_id.vat_label or default_vat_label"/>:
                                    <t t-out="company.vat"/><br/>
                                </t>
                                <t t-if="o and 'partner_bank_id' in o and o.partner_bank_id">
                                    IBAN: <t t-out="o.partner_bank_id.acc_number"/><br/>
                                    <t t-if="o.partner_bank_id.bank_id.bic">BIC: <t t-out="o.partner_bank_id.bank_id.bic"/></t>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </template>

    </data>
</odoo>
